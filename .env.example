# Postgres (compose)
POSTGRES_USER=powerpal
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=powerpal

# API keys — generate e.g. with: openssl rand -hex 32
INGEST_API_KEY=change-me-ingest-key
QUERY_API_KEY=change-me-query-key

# Interface the app container publishes on. Set to your LAN IP or 127.0.0.1
# to keep ingest off other networks; a firewall rule works too.
APP_BIND=0.0.0.0
